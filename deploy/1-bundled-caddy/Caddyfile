secrets.example.com {
        # Discard access logs: the app itself logs nothing (privacy promise),
        # and Caddy would otherwise log every request with client IPs to
        # container stdout (retained by Docker). Re-enable deliberately:
        #   log { output stdout }
        log {
                output discard
        }
        # Cap request bodies: the app already caps the JSON endpoints at 300 KB
        # while reading (chunked-proof); this is defense in depth. 1MB also
        # bounds non-JSON routes. Valid payloads are ~200 KB; 1MB leaves headroom.
        request_body {
                max_size 1MB
        }
        reverse_proxy nveil-app:3000
}
