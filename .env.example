# PostgreSQL credentials (docker-compose reads these; the password applies
# on FIRST volume initialization only — set it before the first start).
POSTGRES_PASSWORD=change-me-strong
# Host port for the app container (container-internal port follows PORT too;
# the shared reverse proxy targets nveil-app:<this port>).
PORT=3000

# ONLY for running the app outside Docker (e.g. `npm run dev` against a
# local PostgreSQL). Docker deployments never read this — compose builds the
# URL from POSTGRES_PASSWORD itself. Adjust user/port to your local database.
DATABASE_URL=postgresql://nveil:nveil@localhost:5432/nveil

# Set to "true" when this instance is reachable from the public internet.
# Shows the legal links in the footer — but only for documents that exist
# in content/ (fill in the templates from content.example/ before going
# live; see README, "Legal pages"). nveil is supported behind exactly one
# TLS-terminating reverse proxy in front (all deploy/ setups provide one);
# direct exposure without a proxy is NOT supported — client-supplied
# X-Forwarded-For headers would defeat the per-IP rate limits. Internal
# deployments: leave unset.
# NVEIL_PUBLIC=true

# General contact address (privacy notice, impressum fallback) and, when set,
# the Contact field of /.well-known/security.txt — which RFC 9116 requires to
# have at least one. Set this (and/or NVEIL_ABUSE_EMAIL below) before going live.
# NVEIL_CONTACT_EMAIL=you@example.com

# Optional dedicated abuse contact (RFC 2142 convention). When set, it appears
# as an additional Contact line in /.well-known/security.txt.
# NVEIL_ABUSE_EMAIL=abuse@example.com

# Access-key gate for managed tenants: when set to "require", only holders
# of a valid create key can create secrets (reads stay open — recipients are
# unaffected). Keys are managed in /management (Access keys tab), unlocked with
# NVEIL_MANAGEMENT_KEY (>= 32 chars, generate with: openssl rand -base64 32).
# Off by default; the public instance and self-hosters are unaffected.
# NVEIL_ACCESS_KEYS=require
# NVEIL_MANAGEMENT_KEY=<generated-secure-key>

# Footer support links are ON by default: "Support this project" (the
# project's Ko-fi) and the GitHub icon. Set to false to hide both — e.g. on
# a white-labeled managed tenant. A "Managed instance" footer link instead
# appears when the operator provides content/managed.html (see README).
# NVEIL_SUPPORT_LINK=false

# Default UI language until the visitor picks one with the footer toggle
# ('en' or 'de'; default 'en').
# NVEIL_DEFAULT_LANGUAGE=en

# Abuse reporting: enables the public "Report abuse" dialog and the operator
# queue at /abuse-reports. Requires a key of at least 32 chars (generate one
# with: openssl rand -base64 32). Reports are shown only to key holders.
# NVEIL_REPORT_ABUSE=true
# NVEIL_REPORT_ABUSE_KEY=<generated-secure-key>

# Optional: override the built-in Cloudflare edge IP list (used to decide
# whether CF-Connecting-IP may be trusted). Point this at
# https://www.cloudflare.com/ips-v4 (concatenated with ips-v6) to refresh:
# NVEIL_CLOUDFLARE_RANGES_URL=

# Rate limits (per client IP — behind corporate NAT/VPN a whole team shares
# one bucket). Rate limiting is ALWAYS active — these are optional overrides
# of the built-in defaults (create: 30/hour, view: 120/min, delete: 60/min).
# Commented = defaults apply; uncomment + set to override.
# Create is limited per hour (a rare, deliberate action); view/delete per
# minute (cheap, bursty actions).
# RATE_LIMIT_CREATE_PER_HOUR=30
# RATE_LIMIT_VIEW_PER_MINUTE=120
# RATE_LIMIT_DELETE_PER_MINUTE=60

# Abuse-reporting limits (only relevant when NVEIL_REPORT_ABUSE is on): public
# reports per hour per IP, operator-queue actions per minute per IP. Raise the
# admin limit if you regularly bulk-delete more than 30 live secrets at once.
# RATE_LIMIT_ABUSE_REPORTS_PER_HOUR=10
# RATE_LIMIT_ABUSE_ADMIN_PER_MINUTE=30

# Only for the deploy/4-cloudflare-tunnel setup: the cloudflared tunnel token
# (create a tunnel in the Cloudflare Zero Trust dashboard, then route its
# public hostname to http://nveil-app:3000). Unused by every other setup.
# TUNNEL_TOKEN=<cloudflare-tunnel-token>
